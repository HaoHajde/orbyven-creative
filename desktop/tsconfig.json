{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/lib/orbyven-supabase": [
        "src/client.ts"
      ],
      "@/*": [
        "../*"
      ],
      "next/dynamic": [
        "src/next-dynamic-shim.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
