{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBYVEN",
  "version": "0.3.0",
  "identifier": "ro.orbyven.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://orbyven.ro https: wss:; font-src 'self' data:; frame-src 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "ORBYVEN — Desktop Workspace",
        "width": 1360,
        "height": 850,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#080d19"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
