# ORBYVEN — example environment configuration
# Copy to .env.local for local development. Never commit real secret values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Platform Core / internal Control Center (Chat 2)
ORBYVEN_CONTROL_CENTER_ADMIN_EMAILS=
ORBYVEN_CONTROL_CENTER_ADMIN_USER_IDS=

# Legal operator — required before commercial LIVE billing can be enabled.
# Stripe TEST mode may run before these values are finalized.
ORBYVEN_LEGAL_NAME=
ORBYVEN_TAX_ID=
ORBYVEN_REGISTRATION_NUMBER=
ORBYVEN_REGISTERED_OFFICE=
ORBYVEN_CONTACT_EMAIL=orbyvent@gmail.com
ORBYVEN_SUPPORT_EMAIL=orbyvent@gmail.com
ORBYVEN_VAT_LABEL=
NEXT_PUBLIC_ORBYVEN_PRICE_TAX_LABEL=

# Billing stays OFF until explicitly enabled.
# Use sk_test_... during development. A live Stripe key also requires
# ORBYVEN_BILLING_LIVE_CONFIRMED=true plus complete legal/tax configuration.
ORBYVEN_BILLING_ENABLED=false
ORBYVEN_BILLING_LIVE_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
# Create a dedicated Stripe Customer Portal configuration with cancellation disabled
# while ORBYVEN uses a 12-month initial commitment.
STRIPE_PORTAL_CONFIGURATION_ID=

# Entitlements are advisory until this is explicitly enabled.
NEXT_PUBLIC_BILLING_ENTITLEMENTS_ENFORCED=false

# No optional-cookie banner is rendered while this is false.
NEXT_PUBLIC_OPTIONAL_COOKIES_ENABLED=false

# Fiscal adapter — disabled by default. Configure only after accountant validation.
ORBYVEN_OBLIO_ENABLED=false
OBLIO_EMAIL=
OBLIO_API_SECRET=
OBLIO_CIF=
OBLIO_INVOICE_SERIES=
OBLIO_VAT_NAME=
OBLIO_VAT_PERCENTAGE=
OBLIO_VAT_INCLUDED=true
OBLIO_SPV_SEND=false
# Vercel can send this automatically as Authorization: Bearer <CRON_SECRET>
# when a Cron Job is configured later.
CRON_SECRET=
