# ORBYVEN — example environment configuration
# Copy to .env.local for local development. Never commit real secret values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated key for the public project-request distributed IP quota (32+ random characters).
# If unset, the server-only SUPABASE_SERVICE_ROLE_KEY is used with domain separation.
# Apply migration 20260928140018_* before deploying the rate-limited server gateway.
ORBYVEN_REQUEST_RATE_LIMIT_SECRET=

# Platform Core / internal Control Center (Chat 2)
ORBYVEN_CONTROL_CENTER_ADMIN_EMAILS=
ORBYVEN_CONTROL_CENTER_ADMIN_USER_IDS=

# Brand ORBYVEN stays unchanged as the contracting merchant moves PFA -> SRL.
# "prelaunch" is NOT a merchant. Set pfa/srl only after lawful formation and approval.
ORBYVEN_COMMERCIAL_ENTITY_TYPE=prelaunch
# Unique opaque key PER issuer; do not reuse PFA key for the SRL (e.g. pfa-2027-01).
ORBYVEN_COMMERCIAL_ENTITY_KEY=
# Safe default: pause only NEW checkout while preparing legal/fiscal transition.
ORBYVEN_COMMERCIAL_CHECKOUT_PAUSED=true
# Public purchase UI defaults to demo unless explicitly switched to live after legal/commercial activation.
NEXT_PUBLIC_ORBYVEN_CHECKOUT_MODE=demo

# Legal operator — required before commercial LIVE billing can be enabled.
# Stripe TEST mode may run before these values are finalized.
ORBYVEN_LEGAL_NAME=
ORBYVEN_TAX_ID=
ORBYVEN_REGISTRATION_NUMBER=
ORBYVEN_REGISTERED_OFFICE=
ORBYVEN_CONTACT_EMAIL=contact@orbyven.ro
ORBYVEN_SUPPORT_EMAIL=support@orbyven.ro

# Optional transactional email for new public project requests.
# Namecheap Private Email is the human inbox; Resend handles application sends.
# Keep OFF until orbyven.ro is verified for SENDING in Resend and the API key
# is configured privately in Vercel. Do NOT commit actual API keys/passwords.
ORBYVEN_PROJECT_EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
ORBYVEN_NOTIFICATION_FROM="ORBYVEN CREATIVE <contact@orbyven.ro>"
ORBYVEN_PROJECT_NOTIFICATION_TO=contact@orbyven.ro
ORBYVEN_VAT_LABEL=
NEXT_PUBLIC_ORBYVEN_PRICE_TAX_LABEL=

# Billing stays OFF until explicitly enabled.
# Use sk_test_... during development. A live Stripe key also requires
# ORBYVEN_BILLING_LIVE_CONFIRMED=true plus complete legal/tax configuration.
ORBYVEN_BILLING_ENABLED=false
ORBYVEN_BILLING_LIVE_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Historical merchant account access during a controlled PFA -> SRL handover.
# Server-only; leave unset until an actual reviewed cutover exists.
STRIPE_ARCHIVE_MERCHANT_KEY=
STRIPE_ARCHIVE_SECRET_KEY=
STRIPE_ARCHIVE_WEBHOOK_SECRET=
STRIPE_ARCHIVE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_START=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
# Create a dedicated Stripe Customer Portal configuration with cancellation disabled
# while ORBYVEN uses a 12-month initial commitment.
STRIPE_PORTAL_CONFIGURATION_ID=

# Entitlements are advisory until this is explicitly enabled.
NEXT_PUBLIC_BILLING_ENTITLEMENTS_ENFORCED=false

# No optional-cookie banner is rendered while this is false.
NEXT_PUBLIC_OPTIONAL_COOKIES_ENABLED=false

# Fiscal adapter — disabled by default. Configure only after accountant validation.
ORBYVEN_OBLIO_ENABLED=false
OBLIO_EMAIL=
OBLIO_API_SECRET=
OBLIO_CIF=
OBLIO_INVOICE_SERIES=
OBLIO_VAT_NAME=
OBLIO_VAT_PERCENTAGE=
OBLIO_VAT_INCLUDED=true
OBLIO_SPV_SEND=false
# Vercel can send this automatically as Authorization: Bearer <CRON_SECRET>
# when a Cron Job is configured later.
CRON_SECRET=


# ORBYVEN Intelligence — Selective Language Layer (Alpha 0.8.6)
# OFF by default. This layer may only rewrite a canonical ORBYVEN answer;
# it never owns business facts, entitlements or Agent Action execution.
# All four values below are required before any external inference can occur.
ORBYVEN_LANGUAGE_LAYER_ENABLED=false
ORBYVEN_LANGUAGE_PROVIDER=
ORBYVEN_LANGUAGE_OPENAI_API_KEY=
# Explicit model ID; intentionally no code default so model changes are an ops decision.
ORBYVEN_LANGUAGE_MODEL=
# Server-side quota clamps: 1..200/day and 1..20/minute per organization.
ORBYVEN_LANGUAGE_DAILY_LIMIT=30
ORBYVEN_LANGUAGE_MINUTE_LIMIT=4


# ORBYVEN Generative Web Design — bounded structured generation
# OFF by default. Server-side only; the browser never receives provider credentials.
# The model returns a validated site schema, never executable HTML/JSX/JavaScript.
ORBYVEN_WEB_DESIGN_AI_ENABLED=false
ORBYVEN_WEB_DESIGN_PROVIDER=
ORBYVEN_WEB_DESIGN_OPENAI_API_KEY=
# Explicit model ID. Keep model changes an operations decision.
ORBYVEN_WEB_DESIGN_MODEL=
# Per-organization server-side quota clamps.
ORBYVEN_WEB_DESIGN_DAILY_LIMIT=20
ORBYVEN_WEB_DESIGN_MINUTE_LIMIT=3
