{
  "name": "web-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ecosystem": "node --experimental-strip-types --test tests/ecosystem-contract.test.mjs tests/thermal-planner-live.test.mjs tests/finance-activity-contract.test.mjs tests/intelligence-core.test.mjs tests/ai-agent-actions.test.mjs tests/ai-estimate-action.test.mjs",
    "test:billing": "node --experimental-strip-types --test tests/billing-webhook-state.test.mjs tests/billing-merchant-contract.test.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:ecosystem && npm run test:billing && npm run test:security && npm run test:compliance && npm run test:orders && node --test tests/pilot-demo-integrity.test.mjs && npm run test:performance && npm run test:seo && npm run test:data && npm run build",
    "test:security": "node --experimental-strip-types --test tests/security-hardening.test.mjs tests/document-signature.test.mjs",
    "test:performance": "node --test tests/performance-boundaries.test.mjs tests/workspace-auth-performance.test.mjs",
    "test:data": "node --experimental-strip-types --test tests/data-efficiency.test.mjs",
    "test:seo": "node --test tests/seo-contract.test.mjs",
    "test:compliance": "node --experimental-strip-types --test tests/compliance-foundation.test.mjs",
    "test:orders": "node --experimental-strip-types --test tests/order-evidence.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
