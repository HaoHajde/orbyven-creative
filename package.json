{
  "name": "web-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ecosystem": "node --test tests/ecosystem-contract.test.mjs",
    "test:billing": "node --experimental-strip-types --test tests/billing-webhook-state.test.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:ecosystem && npm run test:billing && node --test tests/pilot-demo-integrity.test.mjs && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
