{
  "expo": {
    "name": "ORBYVEN",
    "slug": "orbyven-ios",
    "version": "0.1.0",
    "scheme": "orbyven",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ro.orbyven.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "splash": {
      "backgroundColor": "#08111f",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "extra": {
      "orbyvenBaseUrl": "https://orbyven.ro"
    },
    "icon": "./assets/icon.png"
  }
}
